@page "/productivity"
@layout MainLayout

<div class="dashboard-page">
    <section class="hero-card">
        <div>
            <p class="eyebrow">Quick actions</p>
            <h2>Productivity at a glance</h2>
            <p class="hero-copy">This page now follows the same polished card structure as the rest of the app.</p>
        </div>
    </section>

    <section class="content-grid">
        <article class="info-card">
            <div class="card-title">Daily focus</div>
            <div class="list-stack">
                <div class="list-row"><span>Review sprint plan</span><strong>09:00</strong></div>
                <div class="list-row"><span>Design review</span><strong>11:30</strong></div>
                <div class="list-row"><span>Send updates</span><strong>16:00</strong></div>
            </div>
        </article>

        <article class="info-card">
            <div class="card-title">Progress</div>
            <div class="list-stack">
                <div class="list-row"><span>Tasks completed</span><strong>14/18</strong></div>
                <div class="list-row"><span>Momentum</span><strong>High</strong></div>
                <div class="list-row"><span>Focus score</span><strong>91%</strong></div>
            </div>
        </article>
    </section>
</div>
