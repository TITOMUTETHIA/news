@page "/weather"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Web
@using news.Services
@inject IWeatherService WeatherService

<div class="dashboard-page">
    <section class="hero-card hero-panel">
        <div>
            <p class="eyebrow">Weather forecast</p>
            <h2>Live conditions for your day</h2>
            <p class="hero-copy">Search for a city to see the latest conditions and hourly outlook.</p>
        </div>
        <div class="search-row">
            <input class="search-input"
                   value="@locationQuery"
                   @oninput="OnLocationChanged"
                   @onkeydown="OnLocationKeyDown"
                   placeholder="Enter a city or town" />
            <div class="button-row">
                <button class="primary-button" @onclick="SearchAsync">Search weather</button>
                <button class="secondary-button" @onclick="RefreshAsync">Refresh</button>
            </div>
        </div>
    </section>

    @if (isLoading)
    {
        <div class="status-card">Loading forecast…</div>
    }
    else if (errorMessage is not null)
    {
        <div class="status-card error">@errorMessage</div>
    }
    else if (dashboard is not null)
    {
        <section class="hero-card weather-highlight">
            <div>
                <p class="eyebrow">Now in @dashboard.City</p>
                <h3>@dashboard.Condition</h3>
                <p class="hero-copy">@dashboard.Summary</p>
            </div>
            <div class="temp-badge">@dashboard.TemperatureC.ToString("0")°C</div>
        </section>

        <section class="content-grid">
            <article class="info-card">
                <div class="card-title">Hourly outlook</div>
                <div class="list-stack">
                    @foreach (var item in dashboard.Forecasts)
                    {
                        <div class="list-row">
                            <span>@item.Time</span>
                            <span>@item.Icon</span>
                            <strong>@item.Temp</strong>
                        </div>
                    }
                </div>
            </article>

            <article class="info-card">
                <div class="card-title">Key metrics</div>
                <div class="list-stack">
                    <div class="list-row"><span>Feels like</span><strong>@dashboard.FeelsLikeC.ToString("0")°C</strong></div>
                    <div class="list-row"><span>Humidity</span><strong>@dashboard.HumidityPercent.ToString("0")%</strong></div>
                    <div class="list-row"><span>Wind</span><strong>@dashboard.WindKph.ToString("0") km/h</strong></div>
                    <div class="list-row"><span>Rain chance</span><strong>@dashboard.PrecipitationChance.ToString("0")%</strong></div>
                </div>
            </article>
        </section>
    }
</div>

@code {
    private WeatherDashboard? dashboard;
    private bool isLoading;
    private string? errorMessage;
    private string locationQuery = "Berlin";

    protected override async Task OnInitializedAsync() => await SearchAsync();

    private void OnLocationChanged(ChangeEventArgs e)
    {
        locationQuery = e.Value?.ToString() ?? string.Empty;
    }

    private async Task OnLocationKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        await LoadWeatherAsync(locationQuery);
    }

    private async Task RefreshAsync()
    {
        await LoadWeatherAsync(locationQuery);
    }

    private async Task LoadWeatherAsync(string requestedLocation)
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var effectiveLocation = string.IsNullOrWhiteSpace(requestedLocation)
                ? "Berlin"
                : requestedLocation.Trim();

            locationQuery = effectiveLocation;
            dashboard = await WeatherService.GetForecastAsync(effectiveLocation);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load weather data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
