@page "/weather"
@layout MainLayout
@using news.Services
@inject IWeatherService WeatherService

<div class="dashboard-page">
    <section class="hero-card hero-panel">
        <div>
            <p class="eyebrow">Weather forecast</p>
            <h2>Live conditions for your day</h2>
            <p class="hero-copy">Search for a city to see the latest conditions and hourly outlook.</p>
        </div>
        <div class="search-row">
            <input class="search-input" @bind="locationQuery" @bind:event="oninput" placeholder="Enter a city or town" />
            <button class="primary-button" @onclick="ReloadAsync">Search weather</button>
        </div>
    </section>

    @if (isLoading)
    {
        <div class="status-card">Loading forecast…</div>
    }
    else if (errorMessage is not null)
    {
        <div class="status-card error">@errorMessage</div>
    }
    else if (dashboard is not null)
    {
        <section class="hero-card weather-highlight">
            <div>
                <p class="eyebrow">Now in @dashboard.City</p>
                <h3>@dashboard.Condition</h3>
                <p class="hero-copy">@dashboard.Summary</p>
            </div>
            <div class="temp-badge">@dashboard.TemperatureC.ToString("0")°C</div>
        </section>

        <section class="content-grid">
            <article class="info-card">
                <div class="card-title">Hourly outlook</div>
                <div class="list-stack">
                    @foreach (var item in dashboard.Forecasts)
                    {
                        <div class="list-row">
                            <span>@item.Time</span>
                            <span>@item.Icon</span>
                            <strong>@item.Temp</strong>
                        </div>
                    }
                </div>
            </article>

            <article class="info-card">
                <div class="card-title">Key metrics</div>
                <div class="list-stack">
                    <div class="list-row"><span>Feels like</span><strong>@dashboard.FeelsLikeC.ToString("0")°C</strong></div>
                    <div class="list-row"><span>Humidity</span><strong>@dashboard.HumidityPercent.ToString("0")%</strong></div>
                    <div class="list-row"><span>Wind</span><strong>@dashboard.WindKph.ToString("0") km/h</strong></div>
                    <div class="list-row"><span>Rain chance</span><strong>@dashboard.PrecipitationChance.ToString("0")%</strong></div>
                </div>
            </article>
        </section>
    }
</div>

@code {
    private WeatherDashboard? dashboard;
    private bool isLoading;
    private string? errorMessage;
    private string locationQuery = "Berlin";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            dashboard = await WeatherService.GetForecastAsync(locationQuery);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load weather data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
